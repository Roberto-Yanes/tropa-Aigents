{
  "name": "agentes-comunidad-desktop",
  "version": "0.2.5",
  "description": "Equipos de agentes con tus cuentas de IA",
  "author": "Tropa AI",
  "private": true,
  "license": "Apache-2.0",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "org.comunidad.agentes",
    "productName": "Tropa AI",
    "asar": true,
    "directories": {
      "output": "../release-native"
    },
    "files": [
      "main.cjs",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/backend",
        "to": "backend"
      },
      {
        "from": "stage/runtime",
        "to": "runtime"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Tropa AI",
      "icon": "icons/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "icons/tropa-ai.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "icons/tropa-ai.icns"
    },
    "dmg": {
      "sign": false
    },
    "artifactName": "Tropa-AI-${version}-${os}-${arch}.${ext}",
    "afterPack": "after-pack.cjs",
    "deb": {
      "packageName": "tropa-ai",
      "compression": "gz",
      "fpm": [
        "--replaces",
        "agentes-comunidad-desktop",
        "--conflicts",
        "agentes-comunidad-desktop",
        "org.comunidad.agentes.metainfo.xml=/usr/share/metainfo/org.comunidad.agentes.metainfo.xml"
      ]
    }
  },
  "homepage": "https://tropa.galateasoftware.com.ar/",
  "desktopName": "org.comunidad.agentes.desktop"
}
